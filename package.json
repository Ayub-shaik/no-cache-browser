{
  "name": "no-cache-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Developer-focused browser with NCB product window and save-nothing (ephemeral) no-cache mode",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/host/ui/static && cp -f src/host/ui/static/index.html dist/host/ui/static/index.html",
    "start": "node dist/host/main.js",
    "dev": "npm run build && node dist/host/main.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fetch-engine-binary": "node scripts/fetch-engine-binary-linux.mjs",
    "fetch-engine-binary:windows": "node scripts/fetch-engine-binary-windows.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.6.3"
  }
}
