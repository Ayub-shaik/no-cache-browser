{
  "name": "no-cache-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Developer-focused browser with optional no-cache mode (MVP host)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/host/main.js",
    "dev": "npm run build && node dist/host/main.js",
    "test": "npm run build && node --test dist/tests/smoke.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
